# ---- Домены и адреса (обязательно) ----------------------------------------
DOMAIN=traduzione.tech
SERVER_IP=178.105.192.76

# Панель и подписка. Проксируются Cloudflare.
PANEL_DOMAIN=panel.traduzione.tech
SUB_DOMAIN=panel.traduzione.tech

# Домен для Hysteria2. A-запись ОБЯЗАТЕЛЬНО без проксирования (CF не проксирует UDP).
HY2_DOMAIN=hy2.traduzione.tech

ACME_EMAIL=you@example.com

# ---- Режим установки ------------------------------------------------------
# yes = на машине уже есть чужой продакшен. Скрипт тогда НЕ трогает firewall,
# SSH и sysctl, не поднимает свой Caddy и не перезапускает docker.
# Проксирование панели и выпуск сертификата — на существующем reverse proxy.
SHARED_HOST=no

# Имя контейнера чужого reverse proxy (нужно только при SHARED_HOST=yes,
# чтобы забирать у него сертификат для Hysteria2).
CADDY_CONTAINER=

# ---- Доступ ---------------------------------------------------------------
# IP, с которого разрешён SSH. Пусто = разрешён отовсюду (не рекомендуется).
SSH_ALLOW_IP=
SSH_PORT=22

# ---- Порты ----------------------------------------------------------------
# Порт, на котором панель доступна снаружи. При SHARED_HOST=yes это порт
# существующего reverse proxy — обычно 443, и тогда он не попадает в ссылки.
PANEL_HTTPS_PORT=8443
XRAY_REALITY_PORT=443     # основной inbound VLESS/TCP/REALITY/Vision (TCP)
XRAY_GRPC_PORT=2087       # резервный inbound VLESS/gRPC/REALITY (TCP)
HY2_PORT=443              # Hysteria2 (UDP) — с TCP/443 не конфликтует

# Port hopping: клиент прыгает по диапазону UDP-портов, сервер редиректит их
# на HY2_PORT. Помогает против пер-портового шейпинга у операторов.
# Пусто = выключено. Пример: 20000-20050
HY2_PORT_HOPPING=

NODE_PORT=2222            # внутренний API Remnawave Node, наружу закрыт

# ---- REALITY --------------------------------------------------------------
# Сайт-донор TLS-хендшейка. Требования и проверка — docs/RUNBOOK.md.
REALITY_DEST=
