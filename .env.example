# ---- Домены (обязательно) -------------------------------------------------
# Панель и подписка. Можно один домен: подписка живёт на /api/sub.
PANEL_DOMAIN=panel.example.com
SUB_DOMAIN=panel.example.com
ACME_EMAIL=you@example.com

# ---- Доступ ---------------------------------------------------------------
# IP, с которого разрешён SSH. Пусто = разрешён отовсюду (не рекомендуется).
SSH_ALLOW_IP=
SSH_PORT=22

# ---- Порты ----------------------------------------------------------------
PANEL_HTTPS_PORT=8443     # Caddy -> панель и подписка (проксируется Cloudflare)
XRAY_REALITY_PORT=443     # основной inbound VLESS/TCP/REALITY/Vision
XRAY_GRPC_PORT=2087       # резервный inbound VLESS/gRPC/REALITY
NODE_PORT=2222            # внутренний API Remnawave Node, наружу закрыт

# ---- REALITY --------------------------------------------------------------
# Сайт-донор TLS-хендшейка. Требования и проверка — docs/RUNBOOK.md.
REALITY_DEST=
