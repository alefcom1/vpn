# Добавить в ГЛОБАЛЬНЫЙ блок существующего Caddyfile (самый верх файла,
# в фигурных скобках до первого сайта). Если глобальный блок уже есть —
# дописать в него содержимое, а не создавать второй.
#
# Нужно, когда Xray занимает 443, а Caddy работает за ним: см. docs/SELF-STEAL.md
{
	servers :443 {
		listener_wrappers {
			# Обязательно ПЕРЕД tls: обёртка читает открытый текст до хендшейка.
			#
			# Без неё сайты увидят адрес docker-моста вместо реальных
			# посетителей: сломается геолокация, антифрод, ограничения
			# по частоте запросов и логи.
			proxy_protocol {
				# Xray ходит на опубликованный порт через docker-мост,
				# поэтому источник — адрес шлюза, а не 127.0.0.1.
				#
				# Диапазон широкий: на общей машине любой контейнер сможет
				# подделать заголовок и назваться чужим IP. Для одного
				# владельца сервера приемлемо, для мультиарендной — нет.
				allow 127.0.0.0/8 172.16.0.0/12

				# fallback_policy по умолчанию ignore: соединения без
				# заголовка продолжают работать. Поэтому этот блок можно
				# включить заранее, до перевода портов, ничего не сломав.
			}
			tls
		}

		# HTTP/3 выключен: 443/udp занят Hysteria2. Иначе браузер послушается
		# Alt-Svc, уйдёт в никуда и будет ждать таймаута перед откатом на h2.
		protocols h1 h2
	}
}
